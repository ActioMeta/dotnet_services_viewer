@model Node
@using dotnet_services_viewer.Domain

@{
    ViewData["Title"] = "Node Details";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-0">@Model.Hostname</h1>
            <p class="text-muted mb-0">@Model.IpAddress</p>
        </div>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Edit Settings</a>
            <a asp-action="Index" class="btn btn-primary">Back to Dashboard</a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-light">
                    <h5 class="card-title mb-0">SSH Information</h5>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2"><strong>User:</strong> @Model.SshConfig.Username</li>
                        <li class="mb-2"><strong>Port:</strong> @Model.SshConfig.Port</li>
                        <li class="mb-2"><strong>Key Path:</strong> @(string.IsNullOrEmpty(Model.SshConfig.PrivateKeyPath) ? "None (using Password)" : Model.SshConfig.PrivateKeyPath)</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">Monitored Services</h5>
                    <button class="btn btn-sm btn-light" data-bs-toggle="modal" data-bs-target="#addServiceModal">Add Service</button>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Name</th>
                                    <th>Type</th>
                                    <th>Identifier / Target</th>
                                    <th>Status</th>
                                    <th>CPU Usage</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Services.Any())
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-4 text-muted">
                                            No services are being monitored on this node.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var service in Model.Services)
                                    {
                                        <tr id="service-@service.Id">
                                            <td>@service.Name</td>
                                            <td><span class="badge bg-secondary">@service.Type</span></td>
                                            <td><code class="text-secondary">@service.Identifier</code></td>
                                            <td>
                                                <span class="badge @(service.Status == "Up" ? "bg-success" : (service.Status == "Warning" ? "bg-warning text-dark" : "bg-danger"))">
                                                    @service.Status
                                                </span>
                                            </td>
                                            <td>@(service.Type == ServiceType.WebApi || service.Type == ServiceType.LinuxService ? "-" : $"{service.CurrentCpuUsage}%")</td>
                                            <td>
                                                @if (service.Type != ServiceType.WebApi)
                                                {
                                                    <div class="btn-group btn-group-sm">
                                                        <button onclick="serviceAction(@service.Id, @Model.Id, 'Start')" class="btn btn-outline-success" title="Start"><i class="bi bi-play-fill">Start</i></button>
                                                        <button onclick="serviceAction(@service.Id, @Model.Id, 'Stop')" class="btn btn-outline-danger" title="Stop"><i class="bi bi-stop-fill">Stop</i></button>
                                                        <button onclick="serviceAction(@service.Id, @Model.Id, 'Restart')" class="btn btn-outline-warning" title="Restart"><i class="bi bi-arrow-clockwise">Restart</i></button>
                                                    </div>
                                                }
                                                <form asp-controller="Service" asp-action="Delete" method="post" class="d-inline ms-2">
                                                    <input type="hidden" name="id" value="@service.Id" />
                                                    <input type="hidden" name="nodeId" value="@Model.Id" />
                                                    <button type="submit" class="btn btn-sm btn-link text-danger p-0" onclick="return confirm('Are you sure?')">Remove</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Service Modal -->
<div class="modal fade" id="addServiceModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-controller="Service" asp-action="Create" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Add Service to Monitor</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="nodeId" value="@Model.Id" />
                    <div class="mb-3">
                        <label class="form-label">Service Type</label>
                        <div class="input-group">
                            <select id="discoveryType" name="type" class="form-select">
                                @foreach (var type in Enum.GetValues<ServiceType>())
                                {
                                    <option value="@type">@type</option>
                                }
                            </select>
                            <button type="button" class="btn btn-outline-primary" onclick="discoverServices()">Discover</button>
                        </div>
                    </div>
                    <div id="discoveryResults" class="mb-3 d-none">
                        <label class="form-label">Discovered Services (Click to auto-fill)</label>
                        <div class="list-group" id="discoveryList" style="max-height: 200px; overflow-y: auto;">
                            <!-- Discovered items will appear here -->
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Display Name</label>
                        <input type="text" id="serviceName" name="name" class="form-control" placeholder="e.g. Production Web" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Identifier (Container Name, Service Name, or URL)</label>
                        <input type="text" id="serviceIdentifier" name="identifier" class="form-control" placeholder="e.g. web_app_v1, nginx.service, http://localhost:8080/health" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">CPU Warning Threshold (%)</label>
                        <input type="number" name="cpuThreshold" class="form-control" value="80" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add Service</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/monitoringHub")
            .configureLogging(signalR.LogLevel.Information)
            .build();

        connection.on("ReceiveNodeUpdate", function (update) {
            if (update.nodeId != @Model.Id) return;
            
            if (update.services) {
                update.services.forEach(service => {
                    const row = document.getElementById("service-" + service.id);
                    if (row) {
                        const badgeCell = row.cells[3].querySelector('span');
                        const cpuCell = row.cells[4];

                        if (badgeCell) {
                            badgeCell.innerText = service.status;
                            badgeCell.className = "badge " + (service.status === "Up" ? "bg-success" : (service.status === "Warning" ? "bg-warning text-dark" : "bg-danger"));
                        }
                        if (cpuCell && cpuCell.innerText !== "-") {
                            cpuCell.innerText = Math.round(service.currentCpuUsage) + "%";
                        }
                    }
                });
            }
        });

        connection.start().catch(function (err) {
            return console.error(err.toString());
        });

        function serviceAction(id, nodeId, action) {
            const btn = event.currentTarget;
            const originalText = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

            fetch(`/Service/${action}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: `id=${id}&nodeId=${nodeId}`
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert(`${action} command sent successfully`);
                } else {
                    alert(`Failed to ${action} service`);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('An error occurred');
            })
            .finally(() => {
                btn.disabled = false;
                btn.innerHTML = originalText;
            });
        }

        function discoverServices() {
            const nodeId = @Model.Id;
            const type = document.getElementById('discoveryType').value;
            const list = document.getElementById('discoveryList');
            const resultsDiv = document.getElementById('discoveryResults');
            
            resultsDiv.classList.remove('d-none');
            list.innerHTML = '<div class="text-center p-3"><div class="spinner-border spinner-border-sm"></div> Searching...</div>';

            fetch(`/Service/Discover?nodeId=${nodeId}&type=${type}`)
            .then(response => response.json())
            .then(data => {
                list.innerHTML = '';
                if (data.length === 0) {
                    list.innerHTML = '<div class="list-group-item text-muted">No new services found.</div>';
                } else {
                    data.forEach(service => {
                        const item = document.createElement('button');
                        item.type = 'button';
                        item.className = 'list-group-item list-group-item-action d-flex justify-content-between align-items-center';
                        item.innerHTML = `
                            <span>${service.name}</span>
                            <span class="badge bg-light text-dark border">${service.status}</span>
                        `;
                        item.onclick = () => {
                            document.getElementById('serviceName').value = service.name;
                            document.getElementById('serviceIdentifier').value = service.identifier;
                        };
                        list.appendChild(item);
                    });
                }
            })
            .catch(error => {
                console.error('Error:', error);
                list.innerHTML = '<div class="list-group-item text-danger">Error discovering services.</div>';
            });
        }
    </script>
}
