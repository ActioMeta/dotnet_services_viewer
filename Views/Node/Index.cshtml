@model IEnumerable<Node>

@{
    ViewData["Title"] = "Nodes List";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Nodes</h1>
        <a asp-action="Create" class="btn btn-primary">Add New Node</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No nodes registered yet. Add one to start monitoring.</div>
    }
    else
    {
        <div class="row">
            @foreach (var node in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <h5 class="card-title text-primary">@node.Hostname</h5>
                            <h6 class="card-subtitle mb-2 text-muted">@node.IpAddress</h6>
                            <p class="card-text">
                                <span class="badge bg-secondary">SSH Port: @node.SshConfig.Port</span>
                                <span class="badge bg-info text-dark">User: @node.SshConfig.Username</span>
                            </p>
                            <p class="card-text">
                                <strong>Containers:</strong> @node.Containers.Count
                            </p>
                            <div class="d-grid gap-2">
                                <a href="#" class="btn btn-outline-primary btn-sm">View Details</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
