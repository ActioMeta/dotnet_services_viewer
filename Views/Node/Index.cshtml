@model IEnumerable<Node>

@{
    ViewData["Title"] = "Nodes List";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Nodes Dashboard</h1>
        <a asp-action="Create" class="btn btn-primary">Add New Node</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No nodes registered yet. Add one to start monitoring.</div>
    }
    else
    {
        <div class="row">
            @foreach (var node in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body" id="node-card-@node.Id">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title text-primary mb-0">@node.Hostname</h5>
                                <span id="status-badge-@node.Id" class="badge bg-success">Up</span>
                            </div>
                            <h6 class="card-subtitle mb-3 text-muted">@node.IpAddress</h6>
                            
                            <div class="mt-3">
                                <div class="d-flex justify-content-between small text-muted mb-1">
                                    <span>CPU Usage</span>
                                    <span id="cpu-text-@node.Id">0%</span>
                                </div>
                                <div class="progress" style="height: 8px;">
                                    <div id="cpu-bar-@node.Id" class="progress-bar bg-info" role="progressbar" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>

                            <p class="card-text mt-3 small">
                                <span class="badge bg-secondary">SSH: @node.SshConfig.Port</span>
                                <span class="badge bg-light text-dark">User: @node.SshConfig.Username</span>
                            </p>

                            <div class="mt-3 pt-3 border-top d-flex justify-content-between">
                                <a asp-action="Details" asp-route-id="@node.Id" class="btn btn-sm btn-outline-primary">Details</a>
                                <div>
                                    <a asp-action="Edit" asp-route-id="@node.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                    <form asp-action="Delete" asp-route-id="@node.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this node?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/monitoringHub")
            .configureLogging(signalR.LogLevel.Information)
            .build();

        connection.on("ReceiveNodeUpdate", function (update) {
            console.log("Update received for node " + update.nodeId, update);
            
            const badge = document.getElementById("status-badge-" + update.nodeId);
            const cpuBar = document.getElementById("cpu-bar-" + update.nodeId);
            const cpuText = document.getElementById("cpu-text-" + update.nodeId);

            if (badge) {
                badge.innerText = update.status;
                badge.className = "badge " + (update.status === "Up" ? "bg-success" : (update.status === "Warning" ? "bg-warning text-dark" : "bg-danger"));
            }

            if (cpuBar && update.cpuUsage !== undefined) {
                const usage = Math.round(update.cpuUsage);
                cpuBar.style.width = usage + "%";
                cpuBar.setAttribute("aria-valuenow", usage);
                
                if (usage > 80) cpuBar.className = "progress-bar bg-danger";
                else if (usage > 50) cpuBar.className = "progress-bar bg-warning";
                else cpuBar.className = "progress-bar bg-info";
            }

            if (cpuText && update.cpuUsage !== undefined) {
                cpuText.innerText = Math.round(update.cpuUsage) + "%";
            }
        });

        connection.start().catch(function (err) {
            return console.error(err.toString());
        });
    </script>
}
