@model Node

@{
    ViewData["Title"] = "Edit Node";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow">
                <div class="card-header bg-secondary text-white">
                    <h3 class="card-title mb-0">Edit Node: @Model.Hostname</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Edit">
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Hostname" class="form-label">Hostname</label>
                            <input asp-for="Hostname" class="form-control" />
                            <span asp-validation-for="Hostname" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="IpAddress" class="form-label">IP Address</label>
                            <input asp-for="IpAddress" class="form-control" />
                            <span asp-validation-for="IpAddress" class="text-danger"></span>
                        </div>

                        <h5 class="mt-4 mb-3 border-bottom pb-2">SSH Configuration</h5>

                        <div class="row">
                            <div class="col-md-5">
                                <div class="mb-3">
                                    <label asp-for="SshConfig.Username" class="form-label">Username</label>
                                    <input asp-for="SshConfig.Username" class="form-control" />
                                    <span asp-validation-for="SshConfig.Username" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-5">
                                <div class="mb-3">
                                    <label asp-for="SshConfig.Password" class="form-label">Password</label>
                                    <input asp-for="SshConfig.Password" type="password" class="form-control" placeholder="Leave empty to keep current" />
                                    <span asp-validation-for="SshConfig.Password" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="mb-3">
                                    <label asp-for="SshConfig.Port" class="form-label">Port</label>
                                    <input asp-for="SshConfig.Port" class="form-control" />
                                    <span asp-validation-for="SshConfig.Port" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SshConfig.PrivateKeyPath" class="form-label">Private Key Path (Optional)</label>
                            <input asp-for="SshConfig.PrivateKeyPath" class="form-control" />
                            <span asp-validation-for="SshConfig.PrivateKeyPath" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SshConfig.Passphrase" class="form-label">Key Passphrase (Optional)</label>
                            <input asp-for="SshConfig.Passphrase" type="password" class="form-control" placeholder="Leave empty to keep current" />
                            <span asp-validation-for="SshConfig.Passphrase" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary">Update Node</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
